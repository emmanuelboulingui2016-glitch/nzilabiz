# Copier ce fichier en .env.local pour le développement local

# Base de données (Postgres local via docker-compose, voir ../docker-compose.yml)
DATABASE_URL="postgresql://nzilabiz:nzilabiz_dev_password@localhost:5432/nzilabiz"

# Application
APP_URL="http://localhost:3000"

# Authentification — session JWT maison (voir README « Écarts vs cahier des charges »).
# Générez une valeur avec : openssl rand -base64 32
AUTH_SECRET="changez-moi-en-local-avec-openssl-rand-base64-32"

# OAuth Google (optionnel — laisser vide désactive le bouton "Continuer avec Google")
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Mobile Money — la configuration (opérateurs, numéros marchands, clé API de l'agrégateur) se
# renseigne désormais dans l'application : Paramètres > Mobile Money. Elle est stockée en base,
# par boutique, et non plus ici : chaque commerçant a ses propres identifiants marchands.
# L'encaissement réel via l'agrégateur reste à brancher.

# Administration de la plateforme — adresses e-mail des superadmins, séparées par des virgules.
# Un compte listé ici accède à /superadmin (toutes les boutiques). Laisser vide désactive l'accès.
# Volontairement hors base de données : aucune faille applicative ne peut promouvoir un superadmin.
SUPERADMIN_EMAILS=""
